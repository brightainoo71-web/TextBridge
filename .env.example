# ==============================================================
# BrightSMS Platform Configuration
# ==============================================================

# Core Django Settings
SECRET_KEY=change-me-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Platform Branding & Localization
PLATFORM_NAME=BrightSMS
PLATFORM_TAGLINE=Multi-Business SMS & Customer Engagement Platform
PRIMARY_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵
DEFAULT_SMS_SEGMENT_COST=1

# Database Configuration (Defaults to SQLite in development; uncomment for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/brightsms_db
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=brightsms_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# SMS Provider Configuration
# Supported providers: MOCK, MNOTIFY
ACTIVE_SMS_PROVIDER=MOCK
MNOTIFY_API_KEY=your-mnotify-api-key-here
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# Payment Gateway Configuration (Paystack)
PAYSTACK_PUBLIC_KEY=pk_test_sample_key
PAYSTACK_SECRET_KEY=sk_test_sample_key
PAYSTACK_BASE_URL=https://api.paystack.co
# Test mode lets developers and customers test checkout instantly without live cards
PAYMENT_SANDBOX_MODE=True

# ==============================================================
# Transactional Email (Choose Option A or Option B)
# ==============================================================
# Option A: Google / Gmail SMTP (100% Free with personal or workspace Gmail)
# Requires generating a Google 16-character App Password (not your personal account password)
GMAIL_USER=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Resend.com (Developer Email Gateway)
# RESEND_API_KEY=re_your_api_key_here
# DEFAULT_FROM_EMAIL=BrightSMS <onboarding@resend.dev>

# Celery / Redis Task Queue (Optional in dev, runs in-process synchronous fallback)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=False

# Media & Static Files
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
