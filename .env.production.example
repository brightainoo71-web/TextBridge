# ==============================================================
# TextBridge Production Environment Configuration (.env)
# ==============================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-char-secret-key-for-prod
ALLOWED_HOSTS=app.yourdomain.com,yourdomain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
SECURE_SSL_REDIRECT=True

# Platform Branding
PLATFORM_NAME=TextBridge
PLATFORM_TAGLINE="Enterprise Multi-Tenant SMS & Messaging Infrastructure"
PRIMARY_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=textbridge_db
DB_USER=textbridge_user
DB_PASSWORD=choose_a_strong_database_password_here
DB_HOST=db
DB_PORT=5432
CONN_MAX_AGE=600

# Celery & Redis Task Queue
USE_CELERY=True
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Telecom SMS Provider (mNotify)
ACTIVE_SMS_PROVIDER=MNOTIFY
MNOTIFY_API_KEY=kqTDd5IACaKFNUwPFOLewE2pe
MNOTIFY_BASE_URL=https://api.mnotify.com/api
DEFAULT_SENDER_ID=Abtuniverse

# Payment Gateway (Paystack)
# Swap with live production keys (pk_live_... / sk_live_...) for live transactions
PAYMENT_SANDBOX_MODE=False
PAYSTACK_PUBLIC_KEY=pk_test_90de4189a120bcff976c9e0c319daecc8bea463e
PAYSTACK_SECRET_KEY=sk_test_50a518e3bea47e2f7222f3e9423baa6b9160207f
PAYSTACK_BASE_URL=https://api.paystack.co

# Email Notifications (Google SMTP)
GMAIL_USER=brightainoo71@gmail.com
GMAIL_APP_PASSWORD=nwxqgspulzwhmrbs
DEFAULT_FROM_EMAIL=TextBridge <brightainoo71@gmail.com>
