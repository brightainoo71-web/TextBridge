# ==============================================================================
# TextBridge Production Environment Configuration (.env)
# Multi-Tenant Telecom SMS SaaS Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-this-to-a-very-long-random-secret-key-for-production-min-50-chars!
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
PLATFORM_NAME=TextBridge
PRIMARY_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=textbridge_db
DB_USER=textbridge_user
DB_PASSWORD=YourStrongDatabasePassword2026!
DB_HOST=db
DB_PORT=5432
CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. REDIS & ASYNC CELERY WORKER
# ------------------------------------------------------------------------------
USE_CELERY=True
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. TELECOM GATEWAY (mNotify SMS Ghana)
# ------------------------------------------------------------------------------
# Set to MNOTIFY for live broadcasts across MTN, Telecel, and AT Ghana networks.
# (Set to MOCK only for local development/staging simulator)
ACTIVE_SMS_PROVIDER=MNOTIFY
MNOTIFY_API_KEY=your_live_mnotify_api_key_here
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# ------------------------------------------------------------------------------
# 5. PAYMENTS GATEWAY (Paystack Live Mobile Money & Cards)
# ------------------------------------------------------------------------------
# Set to False to accept real GHS Mobile Money payments via Paystack
PAYMENT_SANDBOX_MODE=False
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Gmail App Password or Resend)
# ------------------------------------------------------------------------------
# Option A: Google SMTP
GMAIL_USER=alerts@yourdomain.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=TextBridge <alerts@yourdomain.com>

# Option B: Resend API (Alternative)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. SECURITY & SSL ENFORCEMENT
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
